# AINTRIX Backend Environment Variables

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
# Local: postgresql://postgres:password@localhost:5432/aintrix
# Production: Use your hosted PostgreSQL URL (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aintrix

# JWT Secret Key (generate a secure random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin Credentials (used for seeding)
ADMIN_EMAIL=admin@aintrix.com
ADMIN_PASSWORD=Aintrix@2026

# Server Config (optional)
HOST=0.0.0.0
PORT=8000
