# AINTRIX Frontend Environment Variables

# Backend API URL
# Local development: Leave empty to use relative path /api
# Production: Set to your deployed backend URL
# Example: REACT_APP_BACKEND_URL=https://api.aintrix.com
REACT_APP_BACKEND_URL=

# If running backend on different port locally, uncomment:
# REACT_APP_BACKEND_URL=http://localhost:8000
